{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "swa: start client",
      "type": "shell",
      "command": "npx",
      "args": [
        "install --force",
        "swa",
        "start",
        "http://localhost:5173",
        "--port",
        "5100"
      ],
      "options":{
        "cwd": "${workspaceFolder}/client"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Welcome to Azure Static Web Apps CLI",
          "endsPattern": "Azure Static Web Apps emulator started at"
        }
      }
    }
  ]
}